{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verification.internal/schemas/cloud-client/publication-queue-reference/v1",
  "title": "PublicationQueueReferenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "tenantId",
    "eventId",
    "eventType",
    "aggregateType",
    "aggregateId"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "publicationOutboxReference" },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "eventId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "eventType": { "enum": ["PublishedRunAccepted", "PublishedRunDeleted"] },
    "aggregateType": { "const": "publishedRun" },
    "aggregateId": { "type": "string", "minLength": 1, "maxLength": 256 }
  }
}
